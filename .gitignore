# Synapse Version Control System - .gitignore

# Visual Studio & IDEs
.vs/
*.user
*.suo
*.db
*.opendb
*.VC.db
ipch/
*.sln
*.vcxproj
*.filters

# CMake Build Outputs
build/
out/
CMakeFiles/
CMakeCache.txt
Makefile
cmake_install.cmake
CMakeSettings.json

# Build Outputs (Executables & Libs)
*.exe
*.o
*.obj
*.pdb
*.ilk
*.lib
*.dll
*.so
*.dylib

# Synapse Local Test Repository (Should not track itself)
.synapse/
.synapseignore
